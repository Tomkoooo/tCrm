{
  "name": "tcrm-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:integration": "pnpm --filter @crm/core test:integration && pnpm --filter @crm/auth test:integration",
    "test:e2e": "pnpm --filter @crm/app test:e2e",
    "test:e2e:ui": "pnpm --filter @crm/app test:e2e:ui",
    "test:e2e:report": "pnpm --filter @crm/app test:e2e:report",
    "test:e2e:install": "pnpm --filter @crm/app test:e2e:install",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "preflight": "pnpm lint && pnpm typecheck && pnpm test && node scripts/verify-button-aschild.mjs && pnpm build",
    "preflight:e2e": "pnpm preflight && pnpm --filter @crm/app test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
