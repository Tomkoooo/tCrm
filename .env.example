# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tcrm

# Auth.js
AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
AUTH_URL=http://localhost:3000

# Secret storage (Titoktár) — AES-256-GCM; falls back to AUTH_SECRET if unset
# SECRETS_ENCRYPTION_KEY=change-me-to-a-dedicated-32-plus-char-secret

# Optional — allow self-service /register (viewer accounts, after setup)
# ALLOW_PUBLIC_REGISTRATION=true

# Seed (optional — used by pnpm --filter @crm/db seed)
SEED_ADMIN_EMAIL=admin@tcrm.local
SEED_ADMIN_PASSWORD=admin123456
